# Copy to .env.local. Without a key the app still runs: add your startup with "Fill in a form".
GEMINI_API_KEY=
# GEMMA_MODEL=gemma-4-26b-a4b-it
# Where the events database lives. Default ~/.nexa/nexa.db: keep it outside the project,
# or `next dev` reloads on every database write. On Fly.io it is /data/nexa.db (the volume).
# NEXA_DB=C:/path/outside/the/project/nexa.db
